{
  "note": "Per-tool parameters: one subsection per tool in tools/, named after the script. A tool reads only its own subsection, and a missing key falls back to the tool's built-in default. Paths: ~ expands to home, relative paths resolve against the workspace root.",

  "subsurface_log": {
    "file": "~/Library/Application Support/Subsurface/<your-log>.xml"
  },

  "noaa_current": {
    "max_speed_ms": 0.25
  },

  "noaa_tide": {},

  "noaa_legacy_current": {
    "max_speed_ms": 0.25,
    "default_tz": "America/Los_Angeles"
  },

  "chs_current": {
    "max_speed_ms": 0.25,
    "default_tz": "America/Vancouver"
  },

  "adcirc_current": {
    "max_speed_ms": 0.25
  },

  "ncei_depth": {
    "user_agent_email": "<your-email>@example.com",
    "default_region": "<VDatum region for your coordinates, e.g. westcoast; see tools/ncei_depth.py --help>"
  },

  "emodnet_depth": {},

  "shore_exposure": {
    "user_agent_email": "<your-email>@example.com",
    "max_fetch_km": 30,
    "shore_span_m": 250
  },

  "pnwdiving_viz": {
    "cache_hours": 1,
    "default_tz": "America/Los_Angeles"
  },

  "nws_forecast": {
    "user_agent_email": "<your-email>@example.com",
    "go_below_ms": 5,
    "nogo_above_ms": 8,
    "short_fetch_shift_ms": 3,
    "gust_margin_ms": 3,
    "offshore_marginal_ms": 8
  },

  "open_meteo_wind": {
    "primary_model": "ecmwf_ifs",
    "cross_check_model": "gfs_seamless",
    "go_below_ms": 5,
    "nogo_above_ms": 8,
    "short_fetch_shift_ms": 3,
    "gust_margin_ms": 3,
    "offshore_marginal_ms": 8
  },

  "diversatlas": {
    "api_key": "<required>"
  },

  "diveatlas": {
    "user_agent_email": "<your-email>@example.com",
    "cache_hours": 1
  }
}
